# Copy this file to ~/.zshenv.local and fill in your secrets.
# ~/.zshenv.local is NOT tracked by the dotfiles repo.

# rclone remotes
export RCLONE_CONFIG_S3_TYPE=s3
export RCLONE_CONFIG_S3_PROVIDER=AWS
export RCLONE_CONFIG_S3_ACCESS_KEY_ID=your-access-key-here
export RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=your-secret-key-here

export RCLONE_CONFIG_S3DEEP_TYPE=s3
export RCLONE_CONFIG_S3DEEP_PROVIDER=AWS
export RCLONE_CONFIG_S3DEEP_ACCESS_KEY_ID=your-access-key-here
export RCLONE_CONFIG_S3DEEP_SECRET_ACCESS_KEY=your-secret-key-here
export RCLONE_CONFIG_S3DEEP_STORAGE_CLASS=DEEP_ARCHIVE
